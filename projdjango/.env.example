# Copy to .env and fill in values. Never commit .env to git.

# --- Required for production (PythonAnywhere) ---
DJANGO_ENV=production
SECRET_KEY=change-me-generate-a-new-secret-key
ALLOWED_HOSTS=yourusername.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
SITE_BASE_URL=https://yourusername.pythonanywhere.com

# QR code target (defaults to SITE_BASE_URL + /accounts/login/ if unset)
# MOBILE_ACCESS_URL=https://yourusername.pythonanywhere.com/accounts/login/

# --- Database (SQLite for local dev; MySQL on PythonAnywhere) ---
# Local dev (default — leave DB_ENGINE unset or use sqlite):
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# PythonAnywhere MySQL example:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=yourusername$babaengbulacan
# DB_USER=yourusername
# DB_PASSWORD=your-mysql-password
# DB_HOST=yourusername.mysql.pythonanywhere-services.com
# DB_PORT=3306

# --- Email (required for verification, password reset, incident notifications) ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=BabaengBulacan <your-email@gmail.com>

# --- Google reCAPTCHA (register keys for your production domain) ---
# RECAPTCHA_SITE_KEY=your-site-key
# RECAPTCHA_SECRET_KEY=your-secret-key
# RECAPTCHA_REQUIRED=True

# --- Optional: encrypt 2FA secrets at rest (recommended in production) ---
# FIELD_ENCRYPTION_KEY=generate-with-cryptography-fernet-generate-key

# --- Timezone ---
TIME_ZONE=Asia/Manila
